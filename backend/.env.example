# =============================================================================
# IntegriSense AI — Backend Environment Variables
# =============================================================================
# This file is a copy of .env.example — edit with your actual values.
# DO NOT commit this file. It is in .gitignore.
# =============================================================================

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

GCP_PROJECT_ID=integrisense-ai-2026
GCP_REGION=us-central1

BIGQUERY_DATASET=integrisense_ds
PUBSUB_TOPIC_INTEGRATION_EVENTS=integration-events
PUBSUB_SUBSCRIPTION_BQ=integration-events-bq-sub
FIRESTORE_DATABASE=(default)

# GEMINI_API_KEY=your-key-here

FIREBASE_PROJECT_ID=integrisense-ai-2026
CORS_ORIGIN=http://localhost:5173

ENABLE_AGENTS=false
ENABLE_BIGQUERY=false
ENABLE_PUBSUB=false
ENABLE_FIRESTORE=false
