# =============================================================================
# IntegriSense AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is in .gitignore.
# For deployed Cloud Run: use Secret Manager instead of .env
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ── GCP Project ───────────────────────────────────────────────────────────────
GCP_PROJECT_ID=integrisense-ai-2026
GCP_REGION=us-central1

# ── BigQuery ──────────────────────────────────────────────────────────────────
BIGQUERY_DATASET=integrisense_ds

# ── Pub/Sub ───────────────────────────────────────────────────────────────────
PUBSUB_TOPIC_INTEGRATION_EVENTS=integration-events
PUBSUB_SUBSCRIPTION_BQ=integration-events-bq-sub

# ── Firestore ─────────────────────────────────────────────────────────────────
FIRESTORE_DATABASE=(default)

# ── Gemini / Vertex AI ────────────────────────────────────────────────────────
# For local development only. In production, use Secret Manager.
GEMINI_API_KEY=your-gemini-api-key-here

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=integrisense-ai-2026

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for dev only.
CORS_ORIGIN=http://localhost:5173

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_AGENTS=false
ENABLE_BIGQUERY=false
ENABLE_PUBSUB=false
ENABLE_FIRESTORE=false
